BasedOnStyle: Google
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Make sure re.h is above baresip.h always
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<re\.h>$'
    Priority: 3
    SortPriority: 3
  - Regex: '^<(baresip|re_[a-z0-9_]+)\.h>$'
    Priority: 3
    SortPriority: 4
  - Regex: '^<[a-z_]+>$'
    Priority: 1
  - Regex: '^<.*>$'
    Priority: 2
  - Regex: '.*'
    Priority: 5
